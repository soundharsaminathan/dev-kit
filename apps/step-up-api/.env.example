DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
PORT=3000
NODE_ENV=development

AUTH_BYPASS=true
FIREBASE_PROJECT_ID=step-up10
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

SESSION_QR_SECRET=
JOBS_SECRET=
CHAT_MASTER_KEY=
PII_MASTER_KEY=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=step-up
# Optional. Used only to parse legacy absolute media URLs already stored in the DB.
# The bucket stays private; the API returns short-lived signed GET URLs for reads.
R2_PUBLIC_URL=https://.r2.cloudflarestorage.com

# Optional. Enables BullMQ, Socket.IO multi-instance fan-out, and unread cache.
# Without it the API still works via inline outbox delivery (single instance).
REDIS_URL=redis://127.0.0.1:6379

# Optional. Razorpay test-mode keys enable live Checkout on booking payment.
# Without them, confirm-payment stays on the local demo path (CI-friendly).
# Studio Settings can also store per-studio keys (env is the fallback).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BOOKING_AMOUNT_PAISE=100

# Optional. Resend API for staff invite emails.
# Without RESEND_API_KEY, invites are still created and the invite URL is returned.
RESEND_API_KEY=
EMAIL_FROM=Step Up <onboarding@resend.dev>
APP_URL=http://localhost:5199

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
PORT=3000
NODE_ENV=development

AUTH_BYPASS=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SESSION_QR_SECRET=
JOBS_SECRET=
CHAT_MASTER_KEY=
PII_MASTER_KEY=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Used only to parse legacy absolute media URLs already stored in the DB.
# The bucket stays private; the API returns short-lived signed GET URLs for reads.
R2_PUBLIC_URL=

# Optional. Enables BullMQ, Socket.IO multi-instance fan-out, and unread cache.
# Without it the API still works via inline outbox delivery (single instance).
REDIS_URL=redis://127.0.0.1:6379

# Optional. Razorpay test-mode keys enable live Checkout on booking payment.
# Without them, confirm-payment stays on the local demo path (CI-friendly).
# Studio Settings can also store per-studio keys (env is the fallback).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BOOKING_AMOUNT_PAISE=100
# Webhook secret from Razorpay Dashboard → Webhooks (payment_link.paid).
# Studios with their own Razorpay account can also store an encrypted
# razorpayWebhookSecret on StudioSettings.
RAZORPAY_WEBHOOK_SECRET=

# Optional. Meta Cloud API (WhatsApp Business) for invoice-created reminders.
# Without these, invoice creation still works; WhatsApp sends are skipped.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=invoice_created
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v21.0
# Public API origin used in the WhatsApp template URL button
# ({API_PUBLIC_URL}/billing/pay/{{1}}). Falls back to APP_URL when unset.
API_PUBLIC_URL=https://step-up-api-2qwqkvvlza-el.a.run.app

# Staff AI agent keys are configured per studio in Settings → Integrations.
# Platform GROQ_API_KEY / GEMINI_API_KEY are not used by the staff agent.

# Optional. GoDaddy Professional Email (Titan) SMTP for invites and receipts.
# Without SMTP_USER/SMTP_PASS, invites are still created and the invite URL is returned.
# If send fails, try SMTP_HOST=smtp.titan.email
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=classa <info@classa.in>
APP_URL=http://localhost:5199

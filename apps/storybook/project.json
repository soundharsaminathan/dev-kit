{
  "name": "storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storybook",
  "projectType": "application",
  "tags": ["scope:storybook", "type:app"],
  "implicitDependencies": ["components", "core", "tokens"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/storybook",
        "command": "tsc -b --pretty false"
      },
      "dependsOn": ["^typecheck", "components:build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vitest run --config vitest.config.ts --project storybook"
      },
      "dependsOn": ["tokens:build:tokens"]
    },
    "test:ci": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx scripts/run-vitest-ci.ts storybook"
      },
      "dependsOn": ["tokens:build:tokens"],
      "outputs": ["{workspaceRoot}/test-results/junit-storybook.xml"]
    },
    "storybook": {
      "executor": "nx:run-script",
      "options": {
        "script": "storybook"
      },
      "continuous": true,
      "dependsOn": ["tokens:build:tokens"]
    },
    "build-storybook": {
      "executor": "nx:run-script",
      "options": {
        "script": "build-storybook"
      },
      "outputs": ["{projectRoot}/storybook-static"],
      "dependsOn": ["components:build"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/storybook",
        "command": "playwright test --config playwright.config.ts"
      },
      "dependsOn": ["tokens:build:tokens"]
    },
    "test:e2e:affected": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx scripts/run-affected-e2e.ts"
      },
      "dependsOn": ["tokens:build:tokens"]
    },
    "test:e2e:update": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/storybook",
        "command": "playwright test --config playwright.config.ts --update-snapshots"
      },
      "dependsOn": ["tokens:build:tokens"]
    }
  }
}

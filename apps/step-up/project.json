{
  "name": "step-up",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/step-up",
  "projectType": "application",
  "tags": ["scope:step-up", "type:app"],
  "implicitDependencies": ["components", "tokens"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/step-up",
        "command": "tsc -b --pretty false"
      },
      "dependsOn": ["^typecheck", "tokens:build:tokens", "components:build"]
    },
    "dev": {
      "executor": "nx:run-script",
      "options": {
        "script": "dev"
      },
      "continuous": true,
      "dependsOn": ["tokens:build:tokens"]
    },
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        "tokens:build:tokens",
        "components:build",
        "icons-packs:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/step-up",
        "command": "vitest run --config vitest.config.ts"
      },
      "dependsOn": ["tokens:build:tokens", "components:build"]
    },
    "test:ci": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/step-up",
        "command": "vitest run --config vitest.config.ts --reporter=default --reporter=github-actions --reporter=junit --outputFile=../../test-results/junit-step-up.xml"
      },
      "dependsOn": ["tokens:build:tokens", "components:build"],
      "outputs": ["{workspaceRoot}/test-results/junit-step-up.xml"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/step-up",
        "command": "playwright test --config playwright.config.ts"
      },
      "dependsOn": ["tokens:build:tokens", "components:build"]
    },
    "test:e2e:critical": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/step-up",
        "command": "playwright test --config playwright.config.ts --project=chromium --grep @critical"
      },
      "dependsOn": ["tokens:build:tokens", "components:build"]
    },
    "test:http": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/step-up",
        "command": "playwright test --config playwright.config.ts --project=http --grep @http"
      },
      "dependsOn": ["tokens:build:tokens", "components:build"]
    },
    "test:smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/step-up",
        "command": "playwright test --config playwright.smoke.config.ts"
      }
    },
    "test:smoke:perf": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/step-up",
        "command": "playwright test --config playwright.smoke.config.ts --grep @perf"
      }
    },
    "test:regression": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm nx run step-up-api:test",
          "pnpm nx run step-up:test",
          "pnpm nx run step-up:test:http",
          "pnpm nx run step-up:test:e2e:critical"
        ],
        "parallel": false
      }
    }
  }
}

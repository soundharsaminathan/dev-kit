{
  "name": "@step-up/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:critical": "playwright test --config playwright.config.ts --project=chromium --grep @critical",
    "test:http": "playwright test --config playwright.config.ts --project=http --grep @http",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:smoke:perf": "playwright test --config playwright.smoke.config.ts --grep @perf",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:lighthouse:home": "node scripts/run-lighthouse.mjs http://127.0.0.1:4173/ 3 lighthouse-results/home",
    "test:lighthouse:login": "node scripts/run-lighthouse.mjs http://127.0.0.1:4173/login 3 lighthouse-results/login",
    "test:lighthouse:auth-setup": "node scripts/setup-lighthouse-auth.mjs",
    "test:lighthouse:authenticated": "node scripts/run-lighthouse-authenticated.mjs",
    "test:lighthouse:suite": "node scripts/run-lighthouse-authenticated.mjs --device=both",
    "analyze:entry": "node scripts/analyze-entry-bundle.mjs",
    "test:gate": "pnpm nx run step-up:test:regression"
  },
  "dependencies": {
    "@dev-ui/components": "workspace:*",
    "@dev-ui/core": "workspace:*",
    "@dev-ui/hooks": "workspace:*",
    "@dev-ui/icons": "workspace:*",
    "@dev-ui/icons-packs": "workspace:*",
    "@dev-ui/tokens": "workspace:*",
    "@internationalized/date": "^3.12.2",
    "@sentry/react": "^9.47.1",
    "@tanstack/react-form": "1.33.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.168.2",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-color": "^3.28.0",
    "@tiptap/extension-font-family": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@xyflow/react": "^12.11.2",
    "@zxing/browser": "^0.2.1",
    "firebase": "^11.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "motion": "11.15.0",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-easy-crop": "^6.2.2",
    "react-leaflet": "^5.0.0",
    "read-excel-file": "^9.3.2",
    "socket.io-client": "^4.8.3",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tanstack/router-plugin": "^1.168.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "lighthouse": "13.4.1",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}

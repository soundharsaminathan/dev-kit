# Local Postgres (default after winget install of PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/loan_mate?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/loan_mate?schema=public

# Remote / Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/loan_mate?sslmode=require
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/loan_mate?sslmode=require

PORT=3010
NODE_ENV=development
AUTH_BYPASS=true

# Production (Cloud Run) — GitHub secrets/vars, synced to GCP on deploy:
# DATABASE_URL / DIRECT_DATABASE_URL  <- secrets.LOAN_MATE_DATABASE_URL / LOAN_MATE_DIRECT_DATABASE_URL
# AUTH_BYPASS=false
# CORS_ORIGIN=https://loan-mate.pages.dev
# APP_URL=https://loan-mate.pages.dev
# PORT is injected by Cloud Run (8080)

# Cloudflare R2 object storage (optional — dev stub URLs when unset)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

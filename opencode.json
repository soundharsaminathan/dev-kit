{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.env.example": "allow",
      "**/*service-account*.json": "deny",
      "**/*firebase-admin*.json": "deny",
      "**/*credential*.json": "deny",
      "**/*secret*.json": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*service-account*.json": "deny",
      "**/*firebase-admin*.json": "deny",
      "**/*credential*.json": "deny",
      "**/*secret*.json": "deny"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "pnpm *": "allow",
      "npm *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "cat .env*": "deny",
      "cat *.env*": "deny",
      "printenv*": "deny",
      "env": "deny",
      "echo $*SECRET*": "deny",
      "echo $*KEY*": "deny",
      "echo $*TOKEN*": "deny",
      "echo $*PASSWORD*": "deny",
      "rm *": "ask",
      "rm -rf *": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}

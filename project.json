{
  "name": "dev-kit",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".",
  "projectType": "application",
  "tags": ["scope:workspace", "type:app"],
  "targets": {
    "biome:check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "biome check ."
      },
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["biome:check", "typecheck", "test"]
    },
    "check-icons-drift": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx scripts/check-icons-drift.ts"
      },
      "dependsOn": ["icons:build:icons"]
    },
    "typecheck": {
      "executor": "nx:noop",
      "dependsOn": [
        "check-icons-drift",
        "tokens:typecheck",
        "icons:typecheck",
        "icons-packs:typecheck",
        "core:typecheck",
        "components:typecheck",
        "storybook:typecheck",
        "showcase:typecheck",
        "check-deprecated"
      ]
    },
    "check-deprecated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx scripts/check-deprecated.ts"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "icons:test",
        "tokens:test",
        "core:test",
        "components:test",
        "showcase:test",
        "storybook:test",
        "scripts:test"
      ]
    },
    "test:ci": {
      "executor": "nx:noop",
      "dependsOn": ["merge-coverage"]
    },
    "merge-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx scripts/merge-coverage.ts"
      },
      "dependsOn": [
        "icons:test:ci",
        "core:test:ci",
        "components:test:ci",
        "tokens:test:ci",
        "showcase:test:ci",
        "storybook:test:ci",
        "scripts:test:ci"
      ],
      "outputs": ["{workspaceRoot}/coverage/coverage-summary.json"]
    },
    "test:coverage": {
      "executor": "nx:noop",
      "dependsOn": ["merge-coverage:coverage"]
    },
    "merge-coverage:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx scripts/merge-coverage.ts"
      },
      "dependsOn": [
        "core:test:coverage",
        "components:test:coverage",
        "tokens:test:coverage",
        "showcase:test:coverage",
        "storybook:test:coverage",
        "scripts:test:coverage"
      ],
      "outputs": ["{workspaceRoot}/coverage/coverage-summary.json"]
    }
  }
}

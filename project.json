{
  "name": "dev-kit",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".",
  "projectType": "application",
  "tags": ["scope:workspace", "type:app"],
  "targets": {
    "biome:check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "biome check ."
      },
      "inputs": ["default", "{workspaceRoot}/biome.json"]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["biome:check", "typecheck", "test"]
    },
    "typecheck": {
      "executor": "nx:noop",
      "dependsOn": [
        "tokens:typecheck",
        "core:typecheck",
        "components:typecheck",
        "storybook:typecheck"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "core:test",
        "components:test",
        "storybook:test",
        "scripts:test"
      ]
    },
    "test:ci": {
      "executor": "nx:noop",
      "dependsOn": ["merge-coverage"]
    },
    "merge-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx scripts/merge-coverage.ts"
      },
      "dependsOn": [
        "core:test:ci",
        "components:test:ci",
        "storybook:test:ci",
        "scripts:test:ci"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/coverage-summary.json",
        "{workspaceRoot}/coverage/lcov.info"
      ]
    },
    "test:coverage": {
      "executor": "nx:noop",
      "dependsOn": ["merge-coverage:coverage"]
    },
    "merge-coverage:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsx scripts/merge-coverage.ts"
      },
      "dependsOn": ["core:test:coverage", "components:test:coverage"],
      "outputs": [
        "{workspaceRoot}/coverage/coverage-summary.json",
        "{workspaceRoot}/coverage/lcov.info"
      ]
    }
  }
}

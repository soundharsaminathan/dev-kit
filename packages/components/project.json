{
  "name": "components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/components/src",
  "projectType": "library",
  "tags": ["scope:components", "type:lib"],
  "implicitDependencies": ["core", "tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-script",

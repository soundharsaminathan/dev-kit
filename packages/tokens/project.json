{
  "name": "tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tokens/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tokens",
        "command": "tsc -b --pretty false"
      }
    },
    "build:tokens": {
      "executor": "nx:run-script",
      "options": {
        "script": "generate-scss"
      },
      "outputs": ["{projectRoot}/scss"]
    }
  }
}

{
  "name": "@dev-ui/tokens",
  "version": "0.0.1",
  "private": true,
  "description": "Design tokens for dev-kit component library",
  "type": "module",
  "exports": {
    "./scss": {
      "types": "./scss.d.ts",
      "import": "./scss/index.scss",
      "default": "./scss/index.scss"
    },
    "./scss/*": "./scss/*",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react-aria-integration": "./src/react-aria-integration.ts",
    "./fonts": {
      "import": "./src/theme-fonts.ts",
      "default": "./src/theme-fonts.ts"
    },
    "./fonts/primary": {
      "import": "./src/theme-fonts-primary.ts",
      "default": "./src/theme-fonts-primary.ts"
    },
    "./theme-font-families": {
      "types": "./src/theme-font-families.ts",
      "import": "./src/theme-font-families.ts",
      "default": "./src/theme-font-families.ts"
    }
  },
  "scripts": {
    "generate-scss": "tsx src/generate-scss.ts",
    "build": "pnpm generate-scss"
  },
  "files": [
    "scss",
    "src"
  ],
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "colorjs.io": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}

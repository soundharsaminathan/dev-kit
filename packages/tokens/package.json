{
  "name": "@dev-ui/tokens",
  "version": "0.0.1",
  "private": true,
  "description": "Design tokens for dev-kit component library",
  "type": "module",
  "exports": {
    "./scss": {
      "types": "./scss.d.ts",
      "import": "./scss/index.scss",
      "default": "./scss/index.scss"
    },
    "./scss/*": "./scss/*",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react-aria-integration": "./src/react-aria-integration.ts"
  },
  "scripts": {
    "generate-scss": "tsx src/generate-scss.ts",
    "build": "pnpm generate-scss"
  },
  "files": [
    "scss",
    "src"
  ],
  "dependencies": {
    "colorjs.io": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}

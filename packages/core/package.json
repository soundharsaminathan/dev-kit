{
  "name": "@dev-ui/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Core utilities for dev-kit component library",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "test:coverage": "vitest run --coverage --config ../../vitest.config.ts --project core"
  },
  "sideEffects": false,
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@dev-ui/icons": "workspace:*",
    "@dev-ui/tokens": "workspace:*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20"
  }
}

{
  "name": "dev-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "nx": "node ./scripts/nx.cjs",
    "build": "pnpm nx run-many -t build --projects=icons,icons-packs,core,components",
    "build:tokens": "pnpm nx run tokens:build:tokens",
    "icons:build": "pnpm nx run icons:build:icons",
    "format": "biome format --write .",
    "typecheck": "pnpm nx run dev-kit:typecheck",
    "check:deprecated": "pnpm exec tsx scripts/check-deprecated.ts",
    "check": "pnpm nx run dev-kit:check",
    "prepare": "husky",
    "test": "pnpm nx run dev-kit:test",
    "test:coverage": "pnpm nx run dev-kit:test:coverage",
    "test:watch": "vitest",
    "storybook": "pnpm nx run storybook:storybook",
    "dev:showcase": "pnpm nx run showcase:dev",
    "dev:step-up": "pnpm nx run step-up:dev",
    "dev:step-up-api": "pnpm nx run step-up-api:dev",
    "build:storybook": "pnpm nx run storybook:build-storybook",
    "test:e2e": "pnpm nx run storybook:test:e2e",
    "test:e2e:update": "pnpm nx run storybook:test:e2e:update",
    "test:showcase:e2e": "pnpm nx run showcase:test:e2e",
    "test:showcase:e2e:update": "pnpm nx run showcase:test:e2e:update",
    "test:step-up:e2e": "pnpm nx run step-up:test:e2e",
    "test:step-up:e2e:critical": "pnpm nx run step-up:test:e2e:critical",
    "test:step-up:regression": "pnpm nx run step-up:test:regression",
    "affected:e2e": "pnpm nx affected -t test:e2e:affected",
    "precommit": "pnpm nx affected -t typecheck --uncommitted --untracked --exclude=storybook,dev-kit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@nx/js": "^23.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "nx": "^23.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "^6.0.3",
    "tsx": "^4.22.4",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}

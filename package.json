{
  "name": "dev-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @dev-ui/tokens run generate-scss && pnpm -r --filter=@dev-ui/* run build",
    "build:tokens": "pnpm --filter @dev-ui/tokens run generate-scss",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -b",
    "check": "biome check . && pnpm run typecheck && pnpm run test",
    "prepare": "husky",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=github-actions --reporter=junit --outputFile=test-results/junit.xml",
    "test:coverage": "vitest run --coverage --project core --project components",
    "test:watch": "vitest",
    "storybook": "pnpm --filter @dev-ui/tokens run generate-scss && pnpm --filter @dev-ui/storybook run storybook",
    "build:storybook": "pnpm --filter @dev-ui/tokens run generate-scss && pnpm --filter @dev-ui/components run build && pnpm --filter @dev-ui/storybook run build-storybook",
    "test:e2e": "pnpm --filter @dev-ui/storybook run test:e2e",
    "test:e2e:update": "pnpm --filter @dev-ui/storybook run test:e2e:update"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}

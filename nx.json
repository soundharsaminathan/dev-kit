{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/e2e/**",
      "!{projectRoot}/**/__tests__/**"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.json"
    ],
    "e2eInputs": [
      "default",
      "{workspaceRoot}/packages/components/src/**/*",
      "{workspaceRoot}/packages/tokens/**/*",
      "{workspaceRoot}/packages/core/**/*",
      "{workspaceRoot}/scripts/affected-e2e-specs.ts",
      "{workspaceRoot}/scripts/run-affected-e2e.ts"
    ]
  },
  "targetDefaults": {
    "build:tokens": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "test:e2e": {
      "cache": true,
      "inputs": ["e2eInputs", "^production"]
    },
    "test:e2e:affected": {
      "cache": true,
      "inputs": ["e2eInputs", "^production"]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js",
      "options": {
        "analyzeSourceFiles": false
      }
    }
  ]
}
